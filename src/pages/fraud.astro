---
import Base from '../layouts/Base.astro';
import Fraud from '../components/Fraud.astro';
import { fraud } from '../i18n/fraud';
const copy = fraud.en;
---
<Base locale="en" title={copy.title} description={copy.description} path="/fraud" locales={['en', 'ko', 'tr']} current="fraud">
  <Fraud copy={copy} locale="en" />
</Base>
