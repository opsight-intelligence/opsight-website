---
import Base from '../../layouts/Base.astro';
import About from '../../components/About.astro';
import { about } from '../../i18n/about';
const copy = about.ko;
---
<Base locale="ko" title={copy.title} description={copy.description} path="/about" locales={['en', 'ko']} current="about" look="editorial">
  <About copy={copy} locale="ko" />
</Base>
