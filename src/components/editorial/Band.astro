---
// One editorial page band: an eyebrow, a heading and an optional lede over
// whatever the page puts inside. "raised" lifts it onto the surface colour
// to separate it from its neighbours. The id lets in-page links land on it.
interface Props { eyebrow: string; title?: string; lede?: string; tone?: 'plain' | 'raised'; id?: string }
const { eyebrow, title, lede, tone = 'plain', id } = Astro.props;
---
<section class={`ed-band ${tone === 'raised' ? 'ed-band--raised' : ''}`} id={id}>
  <div class="ed-inner">
    <header class="ed-head" data-reveal>
      <p class="ed-eyebrow">{eyebrow}</p>
      {title && <h2 class="ed-title">{title}</h2>}
      {lede && <p class="ed-lede">{lede}</p>}
    </header>
    <slot />
  </div>
</section>
