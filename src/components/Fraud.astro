---
// The fraud page body in the editorial look, rendered once per locale from the
// copy object: hero with the animated cluster figure, the four steps as a flow
// that lights up in turn, the watchlist (where the locale sells it), coverage
// as market chips, the live numbers, delivery and the contact panel.
// Live figures keep their ids and provenance; LiveStats fills them at runtime.
import type { Locale } from '../i18n/common';
import { common } from '../i18n/common';
import type { FraudCopy } from '../i18n/fraud';
import ArtFraud from './ArtFraud.astro';
import ContactPanel from './ContactPanel.astro';
import LiveStats from './LiveStats.astro';
import Band from './editorial/Band.astro';
import ChipTabs from './editorial/ChipTabs.astro';
import LiveFigures from './editorial/LiveFigures.astro';
import PageHero from './editorial/PageHero.astro';
import StepFlow from './editorial/StepFlow.astro';
interface Props { copy: FraudCopy; locale: Locale }
const { copy, locale } = Astro.props;
const n = copy.numbers;
const SOURCE = 'stats.json';
const figures = [
  { id: 'stat-entities', label: n.entities, line: 'fraud' as const, source: SOURCE },
  { id: 'stat-bank', label: n.bank, line: 'fraud' as const, source: SOURCE },
  { id: 'stat-phone', label: n.phone, line: 'fraud' as const, source: SOURCE },
  { id: 'stat-crypto', label: n.crypto, line: 'fraud' as const, source: SOURCE },
  { id: 'stat-clusters', label: n.clusters, line: 'fraud' as const, source: SOURCE },
];
---
<PageHero
  eyebrow={copy.hero.eyebrow}
  title={copy.hero.title}
  lead={copy.hero.lead}
  live={{ badge: common[locale].live.badge, text: copy.hero.live }}
  action={{ label: copy.hero.primary, href: '#contact' }}
  line="fraud"
>
  <Fragment slot="art"><ArtFraud /></Fragment>
</PageHero>

<div class="line-fraud">
  <Band eyebrow={copy.what.heading} lede={copy.what.lead} id="what">
    <StepFlow steps={copy.what.blocks} />
  </Band>

  {copy.watch && (
    <Band eyebrow={copy.watch.heading} lede={copy.watch.lead} tone="raised" id="watchlist">
      <div class="ed-cards" data-reveal>
        {copy.watch.blocks.map((b) => (
          <article class="ed-card"><h3>{b.title}</h3><p>{b.body}</p></article>
        ))}
      </div>
      <p class="ed-note">{copy.watch.note}</p>
    </Band>
  )}

  <Band eyebrow={copy.coverage.heading} lede={copy.coverage.lead} id="coverage">
    <ChipTabs id="coverage-tabs" blocks={copy.coverage.blocks} />
  </Band>

  <Band eyebrow={n.heading} lede={n.lead} tone="raised" id="numbers">
    <LiveFigures locale={locale} figures={figures} />
  </Band>

  <Band eyebrow={copy.delivery.heading} id="delivery">
    <div class="callout" data-reveal><p>{copy.delivery.body}</p></div>
  </Band>

  <Band eyebrow={copy.contact.heading} tone="raised" id="contact">
    <h2 class="ed-contact-title">{copy.contact.lead} <em>{copy.contact.sharp}</em></h2>
    <p class="ed-lede" style="margin-bottom:2rem">{copy.contact.sample}</p>
    <ContactPanel locale={locale} subject={copy.contact.button} />
  </Band>
</div>

<LiveStats files={{ 'stats.json': { entities: 'stat-entities', bank: 'stat-bank', phone: 'stat-phone', crypto: 'stat-crypto', clusters: 'stat-clusters' } }} />
