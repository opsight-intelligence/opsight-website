---
// The about page body in the editorial look: hero with the lifecycle figure,
// who Opsight is, credentials, where it works as one statement, how it works,
// the contact panel and the closing statement.
import ContactPanel from './ContactPanel.astro';
import type { AboutCopy } from '../i18n/about';
import Lifecycle from './Lifecycle.astro';
import Band from './editorial/Band.astro';
import PageHero from './editorial/PageHero.astro';
interface Props { copy: AboutCopy; locale: 'en' | 'ko' }
const { copy, locale } = Astro.props;
---
<PageHero eyebrow={copy.hero.eyebrow} title={copy.hero.title} lead={copy.hero.lead}>
  <Fragment slot="art"><Lifecycle /></Fragment>
</PageHero>

<Band eyebrow={copy.who.heading} id="who">
  <div class="ed-prose" data-reveal>{copy.who.body.map((p) => <p>{p}</p>)}</div>
</Band>

<Band eyebrow={copy.credentials.heading} lede={copy.credentials.lead} tone="raised" id="credentials">
  <div class="ed-cards" data-reveal>{copy.credentials.items.map((c) => (<article class="ed-card"><h3>{c.title}</h3><p>{c.body}</p></article>))}</div>
</Band>

<Band eyebrow={copy.where.heading} id="where">
  <p class="ed-statement" data-reveal>{copy.where.body}</p>
</Band>

<Band eyebrow={copy.how.heading} tone="raised" id="how">
  <div class="ed-cards" data-reveal>{copy.how.items.map((i) => (<article class="ed-card"><h3>{i.title}</h3><p>{i.body}</p></article>))}</div>
</Band>

<Band eyebrow={copy.contact.heading} lede={copy.contact.lead} id="contact">
  <ContactPanel locale={locale} />
</Band>

<Band eyebrow={copy.statement.heading} tone="raised" id="statement">
  <div class="ed-prose" data-reveal>{copy.statement.body.map((p) => <p>{p}</p>)}</div>
</Band>
