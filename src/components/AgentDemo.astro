---
// The manufacturing page's live demo: one nightly run of the autonomous
// agent on the synthetic fleet, drawn client-side from agent-demo.json
// (written by opsight-manufacturing's nightly cycle, shipped by the deploy,
// read from the repo's raw URL like the other live files). Everything shown
// is invented data; the reasoning is the engine's, unedited.
interface Props {
  heading: string; lead: string; statement: string;
  colMachine: string; colVerdict: string; colDrift: string; colStability: string; colStops: string;
  actionsLabel: string; plantedLabel: string; normalLabel: string; chartTitle: string; chartNote: string;
  runLabel: string; emptyNote: string;
}
const p = Astro.props;
---
<section class="section" id="agent">
  <div class="eyebrow">{p.heading}</div>
  <p class="muted">{p.lead}</p>
  <div class="callout callout--synthetic">
    <div class="callout__title"><span class="badge badge--synthetic">Synthetic</span> {p.statement}</div>
    <p class="muted" style="margin:0;font-size:var(--text-sm)">{p.runLabel} <span data-agent-run>…</span></p>
  </div>

  <div class="grid" style="margin-top:var(--s-5);grid-template-columns:repeat(auto-fit,minmax(340px,1fr))">
    <div class="card line-manufacturing">
      <div class="card__line"></div>
      <h3>{p.chartTitle}</h3>
      <p class="muted" style="font-size:var(--text-sm)">{p.chartNote}</p>
      <div class="chart" id="agent-chart" role="img" aria-label={p.chartTitle}></div>
      <div class="agent-legend" id="agent-legend"></div>
    </div>
    <div class="card line-manufacturing">
      <div class="card__line"></div>
      <h3>{p.colVerdict}</h3>
      <div class="table-wrap">
        <table class="table" id="agent-table">
          <thead><tr><th>{p.colMachine}</th><th>{p.colVerdict}</th><th class="num">{p.colDrift}</th><th class="num">{p.colStability}</th><th class="num">{p.colStops}</th></tr></thead>
          <tbody><tr><td colspan="5" class="muted">{p.emptyNote}</td></tr></tbody>
        </table>
      </div>
    </div>
  </div>

  <div id="agent-actions" class="stack" style="margin-top:var(--s-5)"></div>
</section>

<script is:inline define:vars={{ actionsLabel: p.actionsLabel, plantedLabel: p.plantedLabel, normalLabel: p.normalLabel }}>
(function () {
  var RAW = 'https://raw.githubusercontent.com/opsight-intelligence/opsight-website/main/agent-demo.json';
  var NS = 'http://www.w3.org/2000/svg';
  function el(tag, attrs, text) { var e = document.createElementNS(NS, tag); Object.keys(attrs || {}).forEach(function (k) { e.setAttribute(k, attrs[k]); }); if (text !== undefined) e.textContent = text; return e; }
  function h(tag, cls, text) { var e = document.createElement(tag); if (cls) e.className = cls; if (text !== undefined) e.textContent = text; return e; }
  var SEV = { critical: 'badge--critical', high: 'badge--high', medium: 'badge--medium', low: 'badge--low' };

  function chart(machines, weeks) {
    var host = document.getElementById('agent-chart'); if (!host) return;
    var W = 520, H = 220, left = 44, right = 16, top = 16, bottom = 28;
    var max = 5; machines.forEach(function (m) { m.weekly_deviation_pct.forEach(function (v) { max = Math.max(max, v); }); });
    max = Math.ceil(max / 5) * 5;
    var x = function (i) { return left + (i / Math.max(1, weeks - 1)) * (W - left - right); };
    var y = function (v) { return top + (1 - v / max) * (H - top - bottom); };
    var svg = el('svg', { viewBox: '0 0 ' + W + ' ' + H, class: 'viz' });
    [0, max / 2, max].forEach(function (v) {
      svg.appendChild(el('line', { x1: left, y1: y(v), x2: W - right, y2: y(v), class: 'viz-grid' }));
      svg.appendChild(el('text', { x: left - 6, y: y(v) + 4, 'text-anchor': 'end', class: 'viz-axis' }, '+' + v + '%'));
    });
    for (var i = 0; i < weeks; i++) svg.appendChild(el('text', { x: x(i), y: H - 8, 'text-anchor': 'middle', class: 'viz-axis' }, 'W' + (i + 1)));
    machines.forEach(function (m) {
      var abnormal = m.verdict && m.verdict.abnormal;
      var d = m.weekly_deviation_pct.map(function (v, i) { return (i ? 'L' : 'M') + x(i) + ' ' + y(v); }).join(' ');
      var path = el('path', { d: d, class: abnormal ? 'agent-line agent-line--abnormal' : 'agent-line' });
      path.appendChild(el('title', {}, m.machine_id + ' · ' + (abnormal ? m.verdict.pattern : 'normal') + ' · ' + m.weekly_deviation_pct.map(function (v) { return v + '%'; }).join(' → ')));
      svg.appendChild(path);
      if (abnormal) {
        var last = m.weekly_deviation_pct.length - 1;
        svg.appendChild(el('circle', { cx: x(last), cy: y(m.weekly_deviation_pct[last]), r: 4, class: 'agent-dot' }));
        svg.appendChild(el('text', { x: x(last) - 6, y: y(m.weekly_deviation_pct[last]) - 8, 'text-anchor': 'end', class: 'viz-value' }, m.machine_id));
      }
    });
    host.appendChild(svg);
  }

  function table(machines) {
    var tbody = document.querySelector('#agent-table tbody'); if (!tbody) return;
    tbody.textContent = '';
    machines.slice().sort(function (a, b) { return (b.verdict && b.verdict.abnormal ? 1 : 0) - (a.verdict && a.verdict.abnormal ? 1 : 0); }).forEach(function (m) {
      var tr = h('tr');
      var td1 = h('td'); td1.appendChild(h('code', '', m.machine_id)); tr.appendChild(td1);
      var td2 = h('td');
      if (m.verdict && m.verdict.abnormal) { var b = h('span', 'badge ' + (SEV[m.verdict.severity] || 'badge--low'), m.verdict.pattern.replace(/_/g, ' ')); td2.appendChild(b); }
      else td2.appendChild(h('span', 'muted', normalLabel));
      tr.appendChild(td2);
      var dev = m.weekly_deviation_pct, st = m.weekly_stability_pct, sp = m.weekly_stops;
      [dev[0] + '% → ' + dev[dev.length - 1] + '%', st[st.length - 1] + '%', sp[0] + ' → ' + sp[sp.length - 1]].forEach(function (t) { var td = h('td', 'num', t); tr.appendChild(td); });
      tbody.appendChild(tr);
    });
  }

  function actions(machines) {
    var host = document.getElementById('agent-actions'); if (!host) return;
    machines.filter(function (m) { return m.verdict && m.verdict.abnormal; }).forEach(function (m) {
      var card = h('article', 'card line-manufacturing'); card.appendChild(h('div', 'card__line'));
      var head = h('div', 'row'); head.style.display = 'flex'; head.style.gap = 'var(--s-2)'; head.style.flexWrap = 'wrap'; head.style.alignItems = 'center';
      head.appendChild(h('code', '', m.machine_id)); head.appendChild(h('span', 'badge ' + (SEV[m.verdict.severity] || 'badge--low'), m.verdict.severity)); head.appendChild(h('span', 'badge badge--line', m.verdict.pattern.replace(/_/g, ' ')));
      card.appendChild(head);
      card.appendChild(h('p', '', m.verdict.hypothesis));
      var ul = h('ul'); ul.style.margin = '0'; ul.style.paddingLeft = '1.2em';
      (m.actions || []).forEach(function (a) {
        var li = h('li'); li.appendChild(h('strong', '', a.tool.replace(/_/g, ' ') + ': ')); li.appendChild(document.createTextNode(a.summary));
        if (a.work_order && a.work_order.done_when) { var s = h('div', 'muted', 'done when ' + a.work_order.done_when); s.style.fontSize = 'var(--text-sm)'; li.appendChild(s); }
        ul.appendChild(li);
      });
      var lab = h('div', 'eyebrow', actionsLabel); lab.style.marginTop = 'var(--s-3)'; card.appendChild(lab); card.appendChild(ul);
      host.appendChild(card);
    });
  }

  fetch(RAW, { cache: 'no-cache' })
    .then(function (r) { return r.ok ? r.json() : null; })
    .then(function (d) {
      if (!d || !d.machines) return;
      document.querySelectorAll('[data-agent-run]').forEach(function (e) { e.textContent = (d.generated_at || '').slice(0, 16).replace('T', ' ') + ' UTC · ' + d.machines.length + ' machines'; });
      chart(d.machines, d.weeks || 6);
      table(d.machines);
      actions(d.machines);
      var lg = document.getElementById('agent-legend');
      if (lg && d.planted) { lg.appendChild(h('span', 'muted', plantedLabel + ' ')); d.planted.forEach(function (p) { var c = h('code', '', p.machine_id + ' (' + p.kind.replace(/_/g, ' ') + ')'); c.style.marginRight = 'var(--s-2)'; lg.appendChild(c); }); }
    })
    .catch(function () { /* the section keeps its placeholder; nothing invented */ });
})();
</script>
