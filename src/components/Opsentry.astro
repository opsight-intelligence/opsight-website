---
// The OpSentry page body in the editorial look, rendered once per locale: hero
// with an illustrative terminal session (labelled as such), the product facts,
// why deterministic, the problem, the three layers as a step flow, red-team and
// production evidence, install commands, governance, what gets blocked as
// chips, plans, other tools and the closing actions.
import type { OpsentryCopy, Block } from '../i18n/opsentry';
import Band from './editorial/Band.astro';
import ChipTabs from './editorial/ChipTabs.astro';
import PageHero from './editorial/PageHero.astro';
import StepFlow from './editorial/StepFlow.astro';
import Terminal from './editorial/Terminal.astro';
interface Props { copy: OpsentryCopy }
const { copy } = Astro.props;
const cards = (blocks: Block[]) => blocks;
---
<PageHero
  eyebrow={copy.hero.eyebrow}
  title={copy.hero.title}
  lead={`${copy.hero.lead} ${copy.hero.sub}`}
  action={{ label: copy.hero.primary, href: copy.hero.primaryHref }}
  secondary={{ label: copy.hero.secondary, href: copy.hero.secondaryHref, external: true }}
  line="opsentry"
>
  <Fragment slot="art"><Terminal {...copy.demo} /></Fragment>
</PageHero>

<div class="line-opsentry">
  <section class="ed-band ed-band--raised">
    <div class="ed-inner">
      <div class="ed-figures" data-reveal style={`--ed-figures:${copy.tiles.length}`}>
        {copy.tiles.map((t) => (
          <div class="ed-figure line-opsentry"><div class="stat__value">{t.value}</div><div class="stat__label">{t.label}</div></div>
        ))}
      </div>
      <div class="callout" style="margin-top:2.5rem" data-reveal>{copy.facts.map((f) => <p>{f}</p>)}</div>
    </div>
  </section>

  <Band eyebrow={copy.deterministic.heading} id="deterministic">
    <div class="ed-prose" data-reveal>
      <p>{copy.deterministic.p1}</p>
      <p>{copy.deterministic.p2}</p>
      <p class="ed-statement">{copy.deterministic.p3}</p>
    </div>
  </Band>

  <Band eyebrow={copy.problem.heading} lede={copy.problem.lead} tone="raised" id="problem">
    <div class="ed-cards" data-reveal>{cards(copy.problem.blocks).map((b) => (<article class="ed-card"><h3>{b.title}</h3><p>{b.body}</p></article>))}</div>
  </Band>

  <Band eyebrow={copy.layers.heading} lede={copy.layers.lead} id="layers">
    <StepFlow steps={copy.layers.blocks} />
  </Band>

  <Band eyebrow={copy.redteam.heading} tone="raised" id="redteam">
    <p class="ed-lede" style="margin-bottom:2rem">{copy.redteam.lead} <a href={copy.redteam.href} target="_blank" rel="noopener">{copy.redteam.link} →</a></p>
    <div class="ed-cards" data-reveal>{copy.redteam.blocks.map((b) => (<article class="ed-card"><h3>{b.title}</h3><p>{b.body}</p></article>))}</div>
  </Band>

  <Band eyebrow={copy.production.heading} id="production">
    <div class="ed-cards" data-reveal>{copy.production.blocks.map((b) => (<article class="ed-card"><h3>{b.title}</h3><p>{b.body}</p></article>))}</div>
  </Band>

  <Band eyebrow={copy.install.heading} lede={copy.install.lead} tone="raised" id="install">
    <div class="table-wrap" data-reveal>
      <table class="table"><tbody>
        {copy.install.items.map((i) => (<tr><th scope="row" style="white-space:nowrap">{i.label}</th><td><code>{i.cmd}</code></td></tr>))}
      </tbody></table>
    </div>
  </Band>

  <Band eyebrow={copy.governance.heading} lede={copy.governance.lead} id="governance">
    <div class="ed-cards" data-reveal>{cards(copy.governance.blocks).map((b) => (<article class="ed-card"><h3>{b.title}</h3><p>{b.body}</p></article>))}</div>
  </Band>

  <Band eyebrow={copy.blocked.heading} tone="raised" id="blocked">
    <ChipTabs id="blocked-tabs" blocks={copy.blocked.blocks} />
  </Band>

  <Band eyebrow={copy.plans.heading} lede={copy.plans.lead} id="plans">
    <div class="ed-cards" data-reveal>
      {copy.plans.items.map((p) => (
        <article class="ed-card ed-plan">
          <h3>{p.name}</h3>
          <div class="ed-plan__price">{p.price}<small>{p.per}</small></div>
          <ul class="ed-list">{p.items.map((i) => <li>{i}</li>)}</ul>
          <a class={`ed-btn ${p.primary ? 'ed-btn--primary' : ''}`} href={p.href}>{p.cta}</a>
        </article>
      ))}
    </div>
  </Band>

  <Band eyebrow={copy.other.heading} tone="raised" id="other">
    <div class="ed-prose" data-reveal><p>{copy.other.p1}</p><p>{copy.other.p2}</p></div>
  </Band>

  <Band eyebrow={copy.cta.heading} lede={copy.cta.lead} id="cta">
    <div class="ed-hero__actions" data-reveal>
      <a class="ed-btn ed-btn--primary" href={copy.cta.primaryHref} target="_blank" rel="noopener">{copy.cta.primary}</a>
      <a class="ed-btn" href={copy.cta.secondaryHref}>{copy.cta.secondary}</a>
    </div>
  </Band>
</div>
