---
// The platform page body in the editorial look, rendered once per locale: hero
// with the lifecycle figure, the question before and after, the layers as an
// interactive stack (exactly as many plates as the copy has layers), the
// exchange as a step flow with what it never does, the honesty list and the ask.
import type { PlatformCopy } from '../i18n/platform';
import ContactPanel from './ContactPanel.astro';
import Lifecycle from './Lifecycle.astro';
import Band from './editorial/Band.astro';
import LayerStack from './editorial/LayerStack.astro';
import PageHero from './editorial/PageHero.astro';
import StepFlow from './editorial/StepFlow.astro';
interface Props { copy: PlatformCopy; locale: 'en' | 'ko' }
const { copy, locale } = Astro.props;
---
<PageHero eyebrow={copy.hero.eyebrow} title={copy.hero.title} lead={copy.hero.lead} line="platform">
  <Fragment slot="art"><Lifecycle /></Fragment>
</PageHero>

<div class="line-platform">
  <Band eyebrow={copy.question.heading} lede={copy.question.lead} id="question">
    <div class="ed-compare" data-reveal>
      <div class="ed-compare__side ed-compare__side--before"><p>{copy.question.before}</p></div>
      <div class="ed-compare__side ed-compare__side--after"><p>{copy.question.after}</p></div>
    </div>
  </Band>

  <Band eyebrow={copy.layers.heading} lede={copy.layers.lead} tone="raised" id="layers">
    <LayerStack id="platform-layers" layers={copy.layers.items.map((l) => ({ title: l.title, body: l.body, state: l.state }))} />
  </Band>

  <Band eyebrow={copy.exchange.heading} lede={copy.exchange.lead} id="exchange">
    <StepFlow steps={copy.exchange.steps} />
    <ul class="ed-list" style="margin-top:2.5rem" data-reveal>{copy.exchange.never.map((n) => <li>{n}</li>)}</ul>
  </Band>

  <Band eyebrow={copy.honesty.heading} tone="raised" id="honesty">
    <ul class="ed-list" data-reveal>{copy.honesty.items.map((i) => <li>{i}</li>)}</ul>
  </Band>

  <Band eyebrow={copy.ask.heading} lede={copy.ask.body} id="ask">
    <ContactPanel locale={locale} subject={copy.ask.heading} />
  </Band>
</div>
