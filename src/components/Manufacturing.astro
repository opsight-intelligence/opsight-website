---
import ContactPanel from './ContactPanel.astro';
import AgentDemo from './AgentDemo.astro';
import HeroBand from './HeroBand.astro';
import ArtManufacturing from './ArtManufacturing.astro';
import AgentPulse from './AgentPulse.astro';
import type { ManufacturingCopy, MfgLocale } from '../i18n/manufacturing';
interface Props { copy: ManufacturingCopy; locale: MfgLocale }
const { copy, locale } = Astro.props;
---
<HeroBand eyebrow={copy.hero.eyebrow} title={copy.hero.title} lead={copy.hero.lead} line="manufacturing">
  <Fragment slot="actions"><a class="btn btn--primary" href="#contact">{copy.hero.primary}</a></Fragment>
  <Fragment slot="art"><ArtManufacturing /></Fragment>
</HeroBand>

<AgentPulse {...copy.pulse} />

<section class="section" id="insights">
  <div class="eyebrow">{copy.insights.heading}</div>
  <p class="muted">{copy.insights.lead}</p>
  <div class="grid">
    {copy.insights.blocks.map((b) => (
      <article class="card line-manufacturing">
        <div class="card__line"></div>
        <h3>{b.title}</h3>
        <p>{b.body}</p>
      </article>
    ))}
  </div>
</section>

<section class="section" id="industries">
  <div class="eyebrow">{copy.industries.heading}</div>
  <p class="muted">{copy.industries.lead}</p>
  <div class="grid">
    {copy.industries.blocks.map((b) => (
      <article class="card line-manufacturing">
        <div class="card__line"></div>
        <h3>{b.title}</h3>
        <p>{b.body}</p>
      </article>
    ))}
  </div>
  <p class="muted" style="margin-top:var(--s-5)">{copy.compliance.body} <a href={copy.compliance.href}>{copy.compliance.link}</a></p>
</section>

<AgentDemo {...copy.agent} />

<div class="band section--tint"><div class="container"><section class="section" id="examples">
  <div class="eyebrow">{copy.examples.heading}</div>
  <p class="muted">{copy.examples.lead}</p>
  <div class="callout callout--synthetic">
    <div class="callout__title"><span class="badge badge--synthetic">{copy.honesty.badge}</span> {copy.honesty.title}</div>
    <p>{copy.honesty.body}</p>
  </div>
  <div class="grid" style="margin-top:var(--s-5)">
    {copy.examples.items.map((x) => (
      <article class="card line-manufacturing">
        <div class="card__line"></div>
        <div class="eyebrow">{x.lens}</div>
        <h3>{x.title}</h3>
        <div style="display:flex;flex-wrap:wrap;gap:var(--s-2)">
          {x.severity && <span class={`badge badge--${x.severity}`}>{x.severityLabel}</span>}
          <span class="badge badge--low">{x.confidence}</span>
          <span class="badge badge--low">{x.causality}</span>
        </div>
        <p>{x.body}</p>
        <p><strong>{x.impactLabel}:</strong> {x.impact}</p>
        <ul style="margin:0;padding-left:1.2em">
          {x.actions.map((a) => <li>{a}</li>)}
        </ul>
      </article>
    ))}
  </div>
</section></div></div>

<section class="section" id="demos">
  <div class="eyebrow">{copy.demos.heading}</div>
  <p class="muted">{copy.demos.lead} <span class="badge badge--synthetic">{copy.honesty.badge}</span></p>
  <div class="hero__actions">
    {copy.demos.items.map((d) => <a class="btn btn--quiet" href={d.href} target="_blank" rel="noopener">{d.label}</a>)}
  </div>
  <p class="muted" style="font-size:var(--text-sm);margin-top:var(--s-4)">{copy.demos.more}</p>
</section>

<section class="section" id="contact">
  <div class="eyebrow">{copy.contact.heading}</div>
  <p>{copy.contact.lead}</p>
  <ContactPanel locale={locale} subject={copy.contact.button} />
  <p class="muted" style="font-size:var(--text-sm);margin-top:var(--s-4)">{copy.contact.sample}</p>
</section>
