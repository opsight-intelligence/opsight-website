---
// The manufacturing page body in the editorial look, rendered once per locale:
// hero with the animated cycle figure, last night's pulse (four numbers and a
// link to the run), the insight principles, industries as chips, the live
// agent run (its own component; the deviation chart draws in on scroll), the
// labelled synthetic examples, the demos and the contact panel.
import ContactPanel from './ContactPanel.astro';
import AgentDemo from './AgentDemo.astro';
import ArtManufacturing from './ArtManufacturing.astro';
import AgentPulse from './AgentPulse.astro';
import Band from './editorial/Band.astro';
import ChipTabs from './editorial/ChipTabs.astro';
import PageHero from './editorial/PageHero.astro';
import type { ManufacturingCopy, MfgLocale } from '../i18n/manufacturing';
interface Props { copy: ManufacturingCopy; locale: MfgLocale }
const { copy, locale } = Astro.props;
---
<PageHero eyebrow={copy.hero.eyebrow} title={copy.hero.title} lead={copy.hero.lead} action={{ label: copy.hero.primary, href: '#contact' }} line="manufacturing">
  <Fragment slot="art"><ArtManufacturing /></Fragment>
</PageHero>

<div class="line-manufacturing">
  <div class="ed-band--raised">
    <div class="ed-classic" data-reveal><AgentPulse {...copy.pulse} /></div>
  </div>

  <Band eyebrow={copy.insights.heading} lede={copy.insights.lead} id="insights">
    <div class="ed-cards" data-reveal>
      {copy.insights.blocks.map((b) => (<article class="ed-card"><h3>{b.title}</h3><p>{b.body}</p></article>))}
    </div>
  </Band>

  <Band eyebrow={copy.industries.heading} lede={copy.industries.lead} tone="raised" id="industries">
    <ChipTabs id="industry-tabs" blocks={copy.industries.blocks} />
    <p class="ed-note">{copy.compliance.body} <a href={copy.compliance.href}>{copy.compliance.link}</a></p>
  </Band>

  <div class="ed-classic" data-reveal><AgentDemo {...copy.agent} /></div>

  <div class="ed-band--raised">
    <div class="ed-classic" data-reveal>
<section class="section" id="examples">
  <div class="eyebrow">{copy.examples.heading}</div>
  <p class="muted">{copy.examples.lead}</p>
  <div class="callout callout--synthetic">
    <div class="callout__title"><span class="badge badge--synthetic">{copy.honesty.badge}</span> {copy.honesty.title}</div>
    <p>{copy.honesty.body}</p>
  </div>
  <div class="grid" style="margin-top:var(--s-5)">
    {copy.examples.items.map((x) => (
      <article class="card line-manufacturing">
        <div class="card__line"></div>
        <div class="eyebrow">{x.lens}</div>
        <h3>{x.title}</h3>
        <div style="display:flex;flex-wrap:wrap;gap:var(--s-2)">
          {x.severity && <span class={`badge badge--${x.severity}`}>{x.severityLabel}</span>}
          <span class="badge badge--low">{x.confidence}</span>
          <span class="badge badge--low">{x.causality}</span>
        </div>
        <p>{x.body}</p>
        <p><strong>{x.impactLabel}:</strong> {x.impact}</p>
        <ul style="margin:0;padding-left:1.2em">
          {x.actions.map((a) => <li>{a}</li>)}
        </ul>
      </article>
    ))}
  </div>
</section>
    </div>
  </div>

  <Band eyebrow={copy.demos.heading} lede={copy.demos.lead} id="demos">
    <div class="ed-hero__actions" data-reveal>
      <span class="badge badge--synthetic">{copy.honesty.badge}</span>
      {copy.demos.items.map((d) => <a class="ed-btn" href={d.href} target="_blank" rel="noopener">{d.label}</a>)}
    </div>
    <p class="ed-note">{copy.demos.more}</p>
  </Band>

  <Band eyebrow={copy.contact.heading} lede={copy.contact.lead} tone="raised" id="contact">
    <ContactPanel locale={locale} subject={copy.contact.button} />
    <p class="ed-note">{copy.contact.sample}</p>
  </Band>
</div>
