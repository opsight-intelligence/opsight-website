---
// The method page body in the editorial look: hero with the lifecycle figure,
// the lifecycle stages as a step flow, the intelligence object's fields, the
// severity scale, the live / synthetic / pseudonymized promise, the sources and
// the stated limits.
import type { MethodCopy } from '../i18n/method';
import Lifecycle from './Lifecycle.astro';
import Band from './editorial/Band.astro';
import PageHero from './editorial/PageHero.astro';
import StepFlow from './editorial/StepFlow.astro';
interface Props { copy: MethodCopy }
const { copy } = Astro.props;
---
<PageHero eyebrow={copy.hero.eyebrow} title={copy.hero.title} lead={copy.hero.lead}>
  <Fragment slot="art"><Lifecycle labels={copy.lifecycle.stages.map((s) => s.title.toUpperCase())} /></Fragment>
</PageHero>

<Band eyebrow={copy.lifecycle.heading} lede={copy.lifecycle.lead} id="lifecycle">
  <StepFlow steps={copy.lifecycle.stages} />
</Band>

<Band eyebrow={copy.object.heading} lede={copy.object.lead} tone="raised" id="object">
  <div class="ed-cards" data-reveal>{copy.object.fields.map((f) => (<article class="ed-card"><h3>{f.title}</h3><p>{f.body}</p></article>))}</div>
</Band>

<Band eyebrow={copy.severity.heading} lede={copy.severity.lead} id="severity">
  <div class="table-wrap" data-reveal>
    <table class="table"><tbody>
      {copy.severity.rows.map((r) => (<tr><th scope="row" style="white-space:nowrap"><span class={`badge badge--${r.level}`}>{r.label}</span></th><td>{r.body}</td></tr>))}
    </tbody></table>
  </div>
</Band>

<Band eyebrow={copy.honesty.heading} tone="raised" id="honesty">
  <div class="ed-cards" data-reveal>
    <div class="callout callout--live"><div class="callout__title"><span class="badge badge--live">Live</span></div><p>{copy.honesty.live}</p></div>
    <div class="callout callout--synthetic"><div class="callout__title"><span class="badge badge--synthetic">Synthetic</span></div><p>{copy.honesty.synthetic}</p></div>
    <div class="callout"><p>{copy.honesty.pseudonymized}</p></div>
  </div>
</Band>

<Band eyebrow={copy.sources.heading} id="sources">
  <div class="ed-cards" data-reveal>{copy.sources.blocks.map((b) => (<article class="ed-card"><h3>{b.title}</h3><p>{b.body}</p></article>))}</div>
</Band>

<Band eyebrow={copy.limits.heading} tone="raised" id="limits">
  <ul class="ed-list" data-reveal>{copy.limits.items.map((i) => <li>{i}</li>)}</ul>
</Band>
