---
// The site's first live charts, drawn client-side from procurement-figures.json
// (written nightly by maritime, shipped by the deploy, read from the repo's
// raw URL like the counts). Two figures:
//   1. clearing rate (낙찰률) by category -- a p25–p75 range bar with the median
//      marked, one row per category, largest first;
//   2. daily volume for the last 30 days -- thin bars, notices and awards as
//      two small multiples so no chart carries two scales or two hues.
// Marks in the line accent only; text in ink tokens; a table view is always
// present for screen readers and for anyone who wants the numbers.
interface Props {
  heading: string; lead: string; more?: string; moreLink?: string; moreHref?: string;
  rateTitle: string; rateNote: string;
  dailyTitle: string; noticesLabel: string; awardsLabel: string;
  tableLabel: string; awardsCol: string; medianCol: string; rangeCol: string; dateCol: string;
}
const p = Astro.props;
---
<section class="section" id="figures">
  <div class="eyebrow">{p.heading}</div>
  <p class="muted">{p.lead} <span class="badge badge--live">Live</span> <span class="muted" data-updated-for="procurement-figures.json"></span></p>
  <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(320px,1fr))">
    <div class="card line-procurement">
      <div class="card__line"></div>
      <h3>{p.rateTitle}</h3>
      <p class="muted" style="font-size:var(--text-sm)">{p.rateNote}</p>
      <div class="chart" id="chart-rate" role="img" aria-describedby="table-rate"></div>
      <details><summary class="muted" style="font-size:var(--text-sm);cursor:pointer">{p.tableLabel}</summary>
        <div class="table-wrap" style="margin-top:var(--s-3)"><table class="table" id="table-rate"><thead><tr><th>{p.rateTitle}</th><th class="num">{p.awardsCol}</th><th class="num">{p.medianCol}</th><th class="num">{p.rangeCol}</th></tr></thead><tbody></tbody></table></div>
      </details>
    </div>
    <div class="card line-procurement">
      <div class="card__line"></div>
      <h3>{p.dailyTitle}</h3>
      <div class="chart" id="chart-notices" role="img" aria-label={p.noticesLabel}></div>
      <div class="chart" id="chart-awards" role="img" aria-label={p.awardsLabel}></div>
      <details><summary class="muted" style="font-size:var(--text-sm);cursor:pointer">{p.tableLabel}</summary>
        <div class="table-wrap" style="margin-top:var(--s-3)"><table class="table" id="table-daily"><thead><tr><th>{p.dateCol}</th><th class="num">{p.noticesLabel}</th><th class="num">{p.awardsLabel}</th></tr></thead><tbody></tbody></table></div>
      </details>
    </div>
  </div>
  {p.more && <p class="muted" style="margin-top:var(--s-4)">{p.more} <a href={p.moreHref}>{p.moreLink}</a></p>}
</section>

<script is:inline define:vars={{ noticesLabel: p.noticesLabel, awardsLabel: p.awardsLabel }}>
(function () {
  var RAW = 'https://raw.githubusercontent.com/opsight-intelligence/opsight-website/main/procurement-figures.json';
  var NS = 'http://www.w3.org/2000/svg';
  function el(tag, attrs, text) {
    var e = document.createElementNS(NS, tag);
    Object.keys(attrs || {}).forEach(function (k) { e.setAttribute(k, attrs[k]); });
    if (text !== undefined) e.textContent = text;
    return e;
  }
  function td(row, text, num) { var c = document.createElement('td'); if (num) c.className = 'num'; c.textContent = text; row.appendChild(c); }
  function fmt(n) { return Number(n).toLocaleString(); }

  function rateChart(rows) {
    var host = document.getElementById('chart-rate'); if (!host) return;
    var W = 520, rowH = 34, top = 28, left = 64, right = 24;
    var H = top + rows.length * rowH + 30;
    var lo = 80, hi = 102;
    rows.forEach(function (r) { lo = Math.min(lo, Math.floor(r.p25 - 2)); hi = Math.max(hi, Math.ceil(r.p75 + 2)); });
    var x = function (v) { return left + ((v - lo) / (hi - lo)) * (W - left - right); };
    var svg = el('svg', { viewBox: '0 0 ' + W + ' ' + H, class: 'viz' });
    [lo, Math.round((lo + hi) / 2), hi].forEach(function (v) {
      svg.appendChild(el('line', { x1: x(v), y1: top - 8, x2: x(v), y2: H - 26, class: 'viz-grid' }));
      svg.appendChild(el('text', { x: x(v), y: H - 10, 'text-anchor': 'middle', class: 'viz-axis' }, v + '%'));
    });
    if (100 >= lo && 100 <= hi) svg.appendChild(el('line', { x1: x(100), y1: top - 8, x2: x(100), y2: H - 26, class: 'viz-ref' }));
    var tbody = document.querySelector('#table-rate tbody');
    rows.forEach(function (r, i) {
      var y = top + i * rowH + rowH / 2;
      svg.appendChild(el('text', { x: left - 10, y: y + 4, 'text-anchor': 'end', class: 'viz-label' }, r.label));
      var bar = el('rect', { x: x(r.p25), y: y - 5, width: Math.max(2, x(r.p75) - x(r.p25)), height: 10, rx: 4, class: 'viz-range' });
      bar.appendChild(el('title', {}, r.label + ' · p25 ' + r.p25 + '% · median ' + r.median + '% · p75 ' + r.p75 + '% · ' + fmt(r.awards) + ' awards'));
      svg.appendChild(bar);
      svg.appendChild(el('circle', { cx: x(r.median), cy: y, r: 5, class: 'viz-median' }));
      svg.appendChild(el('text', { x: x(r.p75) + 8, y: y + 4, class: 'viz-value' }, r.median.toFixed(1) + '%'));
      if (tbody) { var tr = document.createElement('tr'); td(tr, r.label); td(tr, fmt(r.awards), true); td(tr, r.median.toFixed(2) + '%', true); td(tr, r.p25.toFixed(2) + '–' + r.p75.toFixed(2) + '%', true); tbody.appendChild(tr); }
    });
    host.appendChild(svg);
  }

  function barChart(id, days, key, label) {
    var host = document.getElementById(id); if (!host) return;
    var W = 520, H = 120, left = 44, right = 8, top = 22, bottom = 22;
    var max = 1; days.forEach(function (d) { max = Math.max(max, d[key]); });
    var n = days.length, slot = (W - left - right) / n, bw = Math.max(2, slot - 2);
    var y = function (v) { return top + (1 - v / max) * (H - top - bottom); };
    var svg = el('svg', { viewBox: '0 0 ' + W + ' ' + H, class: 'viz' });
    svg.appendChild(el('text', { x: left, y: 14, class: 'viz-label' }, label));
    svg.appendChild(el('text', { x: left - 6, y: top + 4, 'text-anchor': 'end', class: 'viz-axis' }, fmt(max)));
    svg.appendChild(el('line', { x1: left, y1: H - bottom, x2: W - right, y2: H - bottom, class: 'viz-grid' }));
    days.forEach(function (d, i) {
      var bx = left + i * slot + 1, by = y(d[key]);
      var r = el('rect', { x: bx, y: by, width: bw, height: Math.max(0, H - bottom - by), rx: 2, class: 'viz-bar' });
      r.appendChild(el('title', {}, d.date + ' · ' + fmt(d[key]) + ' ' + label.toLowerCase()));
      svg.appendChild(r);
      if (i === 0 || i === n - 1) svg.appendChild(el('text', { x: bx + bw / 2, y: H - 6, 'text-anchor': i === 0 ? 'start' : 'end', class: 'viz-axis' }, d.date.slice(5)));
    });
    host.appendChild(svg);
  }

  fetch(RAW, { cache: 'no-cache' })
    .then(function (r) { return r.ok ? r.json() : null; })
    .then(function (d) {
      if (!d || !d.rate_by_category || !d.daily) return;
      rateChart(d.rate_by_category);
      barChart('chart-notices', d.daily, 'notices', noticesLabel);
      barChart('chart-awards', d.daily, 'awards', awardsLabel);
      var tbody = document.querySelector('#table-daily tbody');
      if (tbody) d.daily.forEach(function (x) { var tr = document.createElement('tr'); td(tr, x.date); td(tr, fmt(x.notices), true); td(tr, fmt(x.awards), true); tbody.appendChild(tr); });
      document.querySelectorAll('[data-updated-for="procurement-figures.json"]').forEach(function (e) { e.textContent = d.as_of ? '· ' + d.as_of : ''; });
    })
    .catch(function () { /* charts stay empty; nothing is invented */ });
})();
</script>
