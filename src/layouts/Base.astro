---
// Base layout: head, nav, footer, and the shared design layer.
// The design CSS is linked from /design/ (served verbatim from public/) rather
// than bundled, so /design/ and every page read the exact same bytes.
import { common, localePath, type Locale } from '../i18n/common';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path: string;                 // locale-less path of this page, e.g. '/' or '/fraud'
  locales: Locale[];            // locales this page exists in (drives hreflang + switch)
  current: 'home' | 'fraud' | 'procurement' | 'manufacturing' | 'opsentry' | 'method' | 'about';
}
const { locale, title, description, path, locales, current } = Astro.props;
const c = common[locale];
const site = 'https://opsightintel.com';
const here = localePath(locale, path);
const others = locales.filter((l) => l !== locale);
const ogImage = `${site}/og/${current}.png`;
---
<!DOCTYPE html>
<html lang={c.htmlLang}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="author" content="Opsight Intelligence">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="canonical" href={site + here}>
{locales.map((l) => <link rel="alternate" hreflang={l} href={site + localePath(l, path)} />)}
<link rel="alternate" hreflang="x-default" href={site + localePath('en', path)}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={site + here}>
<meta property="og:type" content="website">
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:site_name" content="Opsight Intelligence">
<meta property="og:locale" content={c.ogLocale}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content={ogImage}>
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<link rel="stylesheet" href="/design/tokens.css">
<link rel="stylesheet" href="/design/components.css">
<slot name="head" />
</head>
<body>
<nav class="nav" aria-label="Primary">
  <div class="container nav__inner">
    <a class="nav__brand" href={localePath(locale === 'tr' ? 'en' : locale, '/')}>{c.nav.brand}</a>
    <ul class="nav__links">
      <li><a href={localePath(locale, '/fraud')} aria-current={current === 'fraud' ? 'page' : undefined}>{c.nav.fraud}</a></li>
      <li><a href={localePath(locale === 'tr' ? 'en' : locale, '/procurement')} aria-current={current === 'procurement' ? 'page' : undefined}>{c.nav.procurement}</a></li>
      <li><a href={localePath(locale === 'tr' ? 'en' : locale, '/manufacturing')} aria-current={current === 'manufacturing' ? 'page' : undefined}>{c.nav.manufacturing}</a></li>
      <li><a href={localePath(locale === 'tr' ? 'en' : locale, '/opsentry')} aria-current={current === 'opsentry' ? 'page' : undefined}>{c.nav.opsentry}</a></li>
      <li><a href={localePath(locale === 'tr' ? 'en' : locale, '/method')} aria-current={current === 'method' ? 'page' : undefined}>{c.nav.method}</a></li>
      <li><a href={localePath(locale === 'tr' ? 'en' : locale, '/about')} aria-current={current === 'about' ? 'page' : undefined}>{c.nav.about}</a></li>
      {others.map((l) => (
        <li><a class="nav__lang" href={localePath(l, path)} hreflang={l} lang={l}>{c.langNames[l]}</a></li>
      ))}
    </ul>
  </div>
</nav>
<main class="container">
  <slot />
</main>
<footer class="footer">
  <div class="container footer__inner">
    <span>{c.footer.rights}</span>
    <span>{c.footer.method}</span>
  </div>
</footer>
</body>
</html>
