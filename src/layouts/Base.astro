---
// Base layout: head, nav, footer, and the shared design layer.
// look="editorial" adds /design/editorial.css and lets the page run its own
// full-width bands; pages without it keep the classic contained layout.
// The design CSS is linked from /design/ (served verbatim from public/) rather
// than bundled, so /design/ and every page read the exact same bytes.
import { common, localePath, type Locale } from '../i18n/common';
import Reveal from '../components/editorial/Reveal.astro';
import VERSION from '../../VERSION?raw';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path: string;                 // locale-less path of this page, e.g. '/' or '/fraud'
  locales: Locale[];            // locales this page exists in (drives hreflang + switch)
  current: 'home' | 'fraud' | 'procurement' | 'manufacturing' | 'opsentry' | 'platform' | 'method' | 'about';
  look?: 'classic' | 'editorial'; // editorial = the dark wide-band layer in /design/editorial.css; default classic
}
const { locale, title, description, path, locales, current, look = 'classic' } = Astro.props;
const editorial = look === 'editorial';
// Stylesheet links carry the site version: Cloudflare lets browsers keep these
// files for hours, and a release must not pair new pages with old CSS.
const assetVersion = `?v=${VERSION.trim()}`;
const c = common[locale];
const site = 'https://opsightintel.com';
const here = localePath(locale, path);
const others = locales.filter((l) => l !== locale);
const ogImage = `${site}/og/${current}.png`;
---
<!DOCTYPE html>
<html lang={c.htmlLang}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="author" content="Opsight Intelligence">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="canonical" href={site + here}>
{locales.map((l) => <link rel="alternate" hreflang={l} href={site + localePath(l, path)} />)}
<link rel="alternate" hreflang="x-default" href={site + localePath('en', path)}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={site + here}>
<meta property="og:type" content="website">
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:site_name" content="Opsight Intelligence">
<meta property="og:locale" content={c.ogLocale}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content={ogImage}>
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<link rel="stylesheet" href={`/design/tokens.css${assetVersion}`}>
<link rel="stylesheet" href={`/design/components.css${assetVersion}`}>
{editorial && <link rel="preload" href="/fonts/montserrat-latin-wght.woff2" as="font" type="font/woff2" crossorigin>}
{editorial && <link rel="stylesheet" href={`/design/editorial.css${assetVersion}`}>}
<slot name="head" />
</head>
<body class={editorial ? 'look-editorial' : undefined}>
<nav class="nav" aria-label="Primary">
  <div class="container nav__inner">
    <a class="nav__brand" href={localePath(locale, '/')}>{c.nav.brand}</a>
    <ul class="nav__links">
      <li><a href={localePath(locale, '/fraud')} aria-current={current === 'fraud' ? 'page' : undefined}>{c.nav.fraud}</a></li>
      <li><a href={localePath(locale, '/procurement')} aria-current={current === 'procurement' ? 'page' : undefined}>{c.nav.procurement}</a></li>
      <li><a href={localePath(locale, '/manufacturing')} aria-current={current === 'manufacturing' ? 'page' : undefined}>{c.nav.manufacturing}</a></li>
      <li><a href={localePath(locale, '/opsentry')} aria-current={current === 'opsentry' ? 'page' : undefined}>{c.nav.opsentry}</a></li>
      <li><a href={localePath(locale, '/platform')} aria-current={current === 'platform' ? 'page' : undefined}>{c.nav.platform}</a></li>
      <li><a href={localePath(locale, '/method')} aria-current={current === 'method' ? 'page' : undefined}>{c.nav.method}</a></li>
      <li><a href={localePath(locale, '/about')} aria-current={current === 'about' ? 'page' : undefined}>{c.nav.about}</a></li>
      {others.map((l) => (
        <li><a class="nav__lang" href={localePath(l, path)} hreflang={l} lang={l}>{c.langNames[l]}</a></li>
      ))}
    </ul>
  </div>
</nav>
<main class={editorial ? 'ed-main' : 'container'}>
  <slot />
</main>
{editorial && <Reveal />}
<footer class="footer">
  <div class="container footer__inner">
    <span>{c.footer.rights}</span>
    <span>{c.footer.method}</span>
  </div>
</footer>
</body>
</html>
